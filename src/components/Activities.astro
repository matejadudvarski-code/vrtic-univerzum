---
import "../styles/global.css";
---

<section class="container py-5" id="zivot">
  <div class="title-card">
  <h2>Aktivnosti u našem vrtiću</h2>
  </div>

  {Array.from({ length: 15 }, (_, i) => (
    <div class="activity-card mb-4">
      <div class={`row no-gutters align-items-center g-0 ${i % 2 !== 0 ? 'flex-row-reverse' : ''}`}>
        <div class="col-md-6">
          <img src={`/images/activities/activity${i + 1}.jpg`} class="img-fluid activity-image" alt={`Aktivnost ${i + 1}`} style="min-height: 432px;" loading="lazy" />
        </div>
        <div class="col-md-6 text-center p-4">
          <h4 class="fw-bold">Aktivnost {i + 1}</h4>
          <p>Kratak opis aktivnosti {i + 1}. Ovde ide tekst koji objašnjava šta deca rade u ovoj aktivnosti.</p>
        </div>
      </div>
    </div>
  ))}
</section>

<style>
  h2{
    text-align: center;
    margin-bottom: 40px;
    font-size: 1.8rem;
  }
</style>
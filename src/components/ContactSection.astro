---
import "../styles/global.css";
---

<section id="contact" class="contact-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">

        <!-- Contact Form -->
        <form class="contact-form">
          <div class="form-group">
            <input type="text" name="ime" placeholder="Ime" required>
            <input type="text" name="prezime" placeholder="Prezime" required>
          </div>
          <div class="form-group">
            <input type="email" name="email" placeholder="Email" required>
            <input type="text" name="predmet" placeholder="Predmet" required>
          </div>
          <div class="form-group">
            <textarea name="poruka" placeholder="Poruka" rows="5" required></textarea>
          </div>
          <button type="submit" class="submit-btn">Pošalji</button>
        </form>

      </div>
    </div>
  </div>
</section>


<style>
  .contact-section {
  padding: 60px 0;
  text-align: center;
}

.contact-form {
  width: 100%;
}

.form-group {
  display: flex;
  gap: 15px;
  margin-bottom: 15px;
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 10px;
  border-radius: 5px;
  border: 1px solid #ccc;
  font-size: 1rem;
}

.form-group textarea {
  resize: none;
}

.submit-btn {
  background-color: #9760E3;
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 5px;
  font-size: 1rem;
  cursor: pointer;
}

.submit-btn:hover {
  background-color: #7640c0;
}

@media (max-width: 768px) {
  .form-group {
    flex-direction: column;
  }
}

</style>

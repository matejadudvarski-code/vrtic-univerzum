---
import "../styles/global.css";
---

<section id="contact" class="contact-section">
  <div class="container">
    <div class="row align-items-start">
      <!-- Left Column: Info + Map -->
      <div class="col-lg-6 col-md-12 mb-4 text-start">
        <h3>Kontakt informacije</h3>
        <p><strong>Adresa:</strong> Bulevar Mihaila Pupina 165a, Beograd</p>
        <p><strong>Telefon:</strong> 011 2270632 / 064 6414766</p>
        <p><strong>Email:</strong> info@vrticuniverzum.com</p>

        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2830.8761900739333!2d20.410561515805407!3d44.8125987790987!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x475a7050d689b70b%3A0xabc123!2sBulevar%20Mihaila%20Pupina%20165a!5e0!3m2!1sen!2srs!4v1625258494087"
          width="100%"
          height="300"
          style="border: 0"
          allowfullscreen=""
          loading="lazy"
        ></iframe>
      </div>

      <div class="col-lg-6 col-md-12">
        <form class="contact-form">
          <div class="form-group">
            <input type="text" name="ime" placeholder="Ime" required>
            <input type="text" name="prezime" placeholder="Prezime" required>
          </div>
          <div class="form-group">
            <input type="email" name="email" placeholder="Email" required>
            <input type="text" name="predmet" placeholder="Predmet" required>
          </div>
          <div class="form-group">
            <textarea name="poruka" placeholder="Poruka" rows="5" required></textarea>
          </div>
          <button type="submit" class="submit-btn">Pošalji</button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 60px 0;
    text-align: center;
  }

  .contact-form {
    width: 100%;
  }

  .form-group {
    display: flex;
    gap: 15px;
    margin-bottom: 15px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 10px;
    border-radius: 5px;
    border: 1px solid #ccc;
    font-size: 1rem;
  }

  .form-group textarea {
    resize: none;
  }

  .submit-btn {
    background-color: #9760E3;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
    font-size: 1rem;
    cursor: pointer;
  }

  .submit-btn:hover {
    background-color: #7640c0;
  }

  @media (max-width: 768px) {
    .form-group {
      flex-direction: column;
    }

    .row.align-items-start {
      flex-direction: column;
      text-align: center;
    }

    .col-lg-6 {
      margin-bottom: 30px;
    }
  }
</style>

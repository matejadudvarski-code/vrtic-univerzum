---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<div class="d-flex align-items-center justify-content-center my-5">
  <div class="flex-grow-1 border-top border-4 border-dark ms-5"></div>
  
  <div class="px-4 py-2 mx-5 bg-primary-custom text-white text-center rounded shadow-sm" style="min-width: 365px;">
    <h2 class="mb-0 fw-bold text-nowrap">{text}</h2>
  </div>
  
  <div class="flex-grow-1 border-top border-4 border-dark me-5"></div>
</div>

<style>

  .flex-grow-1 {
    border-color: #9760E3 !important;
  }
  .bg-primary-custom {
    background-color: #9760E3 !important;
  }

  .border-4 {
    border-width: 2px !important;
  }

  h2 {
    font-size: 2.2rem;
  }

  @media (max-width: 768px) {
    h2 {
      font-size: 1.3rem;
    }
  }
</style>

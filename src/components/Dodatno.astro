---
import "../styles/global.css";

const services = Array.from({ length: 7 }, (_, i) => ({
  title: `Usluga ${i + 1}`,
  description: `Kratak opis usluge ili aktivnosti broj ${i + 1}.`,
  image: `/images/services/service${i + 1}.jpg`
}));
---

<section class="container py-5" id="stajos">
  <h2 class="text-center mb-5">Dodatne usluge i aktivnosti</h2>
  <div class="row g-4">
    {
      services.map((service, i) => {
        const isLast = i === services.length - 1;
        const isAloneInRow = services.length % 2 !== 0 && isLast;

        return (
          <div
            class={`col-md-6 ${isAloneInRow ? 'mx-auto' : ''} d-flex align-items-stretch`}
          >
            <div class="card w-100">
              <img src={service.image} class="card-img-top" style="max-height: 240px; object-fit: cover;" />
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">{service.title}</h5>
                <p class="card-text">{service.description}</p>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

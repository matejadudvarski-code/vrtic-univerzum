---
import React from "react";
import "../styles/global.css";
---

<div
  class="dot-background-wrapper position-fixed top-0 start-0 w-100 h-100"
  style="
    z-index: -1;
    background-color: rgb(245, 196, 241);
    overflow: hidden;
  "
>
  <!-- Dot Pattern Background -->
  <!-- <div
    class="position-absolute top-0 start-0 w-100 h-100"
    style="
      background-size: 40px 40px;
      background-image: radial-gradient(#ffffff 1px, transparent 1px);
      z-index: 1;
    "
  ></div> -->

  <!-- Radial mask overlay with glow -->
  <div
    class="position-absolute top-0 start-0 w-100 h-100"
    style="
      background-color: white;
      mask-image: radial-gradient(ellipse at center, transparent 20%, black);
      -webkit-mask-image: radial-gradient(ellipse at center, transparent 20%, black);
      pointer-events: none;
      box-shadow: 0 0 60px rgba(255, 255, 255, 0.05), 0 0 120px rgba(255, 255, 255, 0.02);
      z-index: 2;
    "
  ></div>
</div>

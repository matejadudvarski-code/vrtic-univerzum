<style>
  .expanding-cards-container {
    display: flex;
    width: 100%;
    height: 100vh;
    gap: 10px;
    padding: 20px;
    box-sizing: border-box;
  }

  .panel {
    background-size: cover;
    background-position: center;
    border-radius: 10px;
    color: white;
    cursor: pointer;
    flex: 0.5;
    position: relative;
    transition: flex 0.5s ease-in;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }

  .panel h3 {
    font-size: 1.5rem;
    margin: 20px;
    text-shadow: 0 0 10px rgba(0,0,0,0.6);
  }

  .panel.active {
    flex: 5;
  }

  @media (max-width: 768px) {
    .expanding-cards-container {
      flex-direction: column;
      height: auto;
    }

    .panel {
      flex: auto;
      height: 200px;
    }

    .panel.active {
      height: 300px;
    }
  }
</style>

---
import "../styles/global.css";
---

<nav class="navbar navbar-expand-lg">
  <div class="container-fluid d-flex align-items-center" style="margin-left: 130px !important; padding: 10px">
    
    <a class="navbar-brand d-flex align-items-center" href="/">
      <img src="/images/univerzum-logo.png" alt="Univerzum Logo" class="navbar-logo">
    </a>

    <!-- Toggle Button for Mobile -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <i class="bi bi-chevron-down navbar-toggler-icon"></i> <!-- Single Arrow Icon -->
    </button>

    <!-- Navbar Links on the Right -->
    <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
      <ul class="navbar-nav gap-5">
        

        <li class="nav-item">
          <a class="nav-link" href="#zivot">Život Vrtića</a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="#stajos">Šta Još</a>
        </li>

        <!-- "Kutak Za Roditelje" Link -->
        <li class="nav-item">
          <a class="nav-link" href="#kutakzaroditelje">Kutak Za Roditelje</a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="#aktuelnosti">Aktuelnosti</a>
        </li>

        <li role="separator" class="divider"></li>

        <li class="nav-item">
          <a href="#contact" class="btn text-white fs-5 px-4 py-2" style="background-color: #032D6C; border-radius: 20px; margin-right: 20px;">
            Kontakt
          </a>
        </li> 
      </ul>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .navbar-nav {
    margin-right: 10px;
  }

  .navbar-nav .nav-item.dropdown:hover .dropdown-menu {
    animation: fadeIn 0.3s ease-in-out;
  }

  /* Fade In and Out effect */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dropdown-menu {
    display: none;
  }

  .dropdown:hover .dropdown-menu {
    display: block;
    animation: fadeIn 0.3s ease-in-out;
  }

  .navbar-logo {
    width: 220px;
    transition: width 0.3s ease-in-out;
  }

  /* Smaller Logo on Tablets */
  @media (max-width: 768px) {
    .navbar-logo {
      width: 180px;
    }
  }

  /* Even Smaller Logo on Mobile */
  @media (max-width: 480px) {
    .navbar-logo {
      width: 140px;
    }
  }

  @media (max-width: 320px) {
    .navbar-logo {
      width: 120px;
    }
  }
</style>

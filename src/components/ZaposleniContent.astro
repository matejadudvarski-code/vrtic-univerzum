---
import "../styles/global.css";
---

<section class="image-hover-cards-section" id="zaposleni">
  <div class="container d-flex justify-content-center">
    <div class="hover-card" style="width: 80vw; height: 80vh;">
      <img src="/images/DPP_10321477.jpg" alt="Grupna fotografija" class="card-img" loading="lazy" />
      <div class="overlay">
        <h4 class="overlay-title">Naš tim</h4>
        <p class="overlay-text">Upoznajte vaspitače</p>
      </div>
    </div>
  </div>
</section>

<style>
  .image-hover-cards-section {
    padding: 50px 0;
    margin-top: 50px;
  }

  .hover-card {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    cursor: pointer;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .hover-card:hover .card-img {
    transform: scale(1.05);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px;
    transition: opacity 0.3s ease;
    text-align: center;
  }

  .hover-card:hover .overlay {
    opacity: 1;
  }

  .overlay-title {
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 10px;
  }

  .overlay-text {
    font-size: 1rem;
    max-width: 70%;
  }

  @media (max-width: 768px) {
    .hover-card {
      width: 100% !important;
      height: auto !important;
    }

    .card-img {
      height: auto;
    }

    .overlay-text {
      max-width: 90%;
    }
  }
</style>
